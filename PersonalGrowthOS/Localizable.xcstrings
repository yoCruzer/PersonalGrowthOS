    "Backups contain all entry text and original photos and are not encrypted. Import is available only when this database is empty; V1 never merges or erases existing data.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups contain all entry text and original photos and are not encrypted. Import is available only when this database is empty; V1 never merges or erases existing data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份包含全部记录文字和原始照片，且未加密。仅当当前数据库为空时才能导入；V1 不会合并或抹除现有数据。"
          }
        }
      }
    },
