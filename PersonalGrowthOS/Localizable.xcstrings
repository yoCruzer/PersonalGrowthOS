{
  "sourceLanguage": "en",
  "strings": {
  "Recent measurements through %@": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Recent measurements through %@"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "截至 %@ 的最近记录"
        }
      }
    }
  },
  "A stronger system alarm. Requires iOS 26 and alarm permission; stopping it does not complete the todo.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "A stronger system alarm. Requires iOS 26 and alarm permission; stopping it does not complete the todo."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "更强的系统闹钟提醒，需要 iOS 26 及闹钟授权；停止响铃不会完成待办。"
        }
      }
    }
  },
  "Add a weight measurement to calculate BMI.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Add a weight measurement to calculate BMI."
