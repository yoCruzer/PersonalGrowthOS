      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "成人一般筛查参考，不是诊断。这些范围不能直接用于儿童或孕期；肌肉量和高龄等也会影响解释。"
        }
      }
    }
  },
