    "NSAlarmKitUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Schedule alarm reminders that you explicitly enable for your todos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为你明确开启闹钟提醒的待办安排系统闹钟。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture photos you choose to save in your private entries."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄你选择保存在私人记录中的照片。"
          }
        }
      }
    }
